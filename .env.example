# Variáveis públicas do Lúmen (seguras para o client).
# Copie este arquivo para .env.local e ajuste se necessário.
# Nunca coloque chaves privadas, seed phrases ou secrets aqui.

NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_EXPLORER_BASE_URL=https://explorer.solana.com

# Opcional: força erro só no adapter da Solana (doação, trilha e dashboard).
# A autenticação continua funcionando. Reinicie o `npm run dev` após alterar.
# NEXT_PUBLIC_MOCK_FORCE_ERROR=true
